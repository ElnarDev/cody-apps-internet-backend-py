# Variables Críticas del Sistema
PROJECT_NAME="Enterprise API Demo"
API_V1_STR="/api/v1"

# Seguridad y Autenticación JWT
# Usa `openssl rand -hex 32` en Linux para generar una clave fuerte en Producción
SECRET_KEY="487ba163e7d8c7adb216fd8b59e86d3ba7db29a3f4ac7f957d38a0c9040288f9"
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 Horas = 60 * 24

# Base de Datos
# Por defecto local usamos SQLite ("sqlite:///./database.db")
# En producción usaríamos ("postgresql://user:pass@host:5432/db")
DATABASE_URL="sqlite:///./fastapi.db"

# CORS para frontend (separa dominios por coma)
BACKEND_CORS_ORIGINS="http://localhost:4200,http://127.0.0.1:4200,https://TU-FRONTEND.vercel.app"

# Google Gemini AI (Efecto WOW - Opcional)
# Obtén tu llave gratis en: https://aistudio.google.com/
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"


